# Keep passwords and cookies out of the project; use the local interactive login helper.
READCUBE_SESSION_FILE=~/.config/readcube-client/session.json
READCUBE_VERIFICATION_FILE=~/.config/readcube-client/verified.json
READCUBE_TIMEOUT=30
READCUBE_RETRIES=2
READCUBE_MIN_INTERVAL=0.25
READCUBE_DRY_RUN=true
READCUBE_WRITE_COLLECTIONS=[]
READCUBE_UPLOAD_HOSTS=["sync.readcube.com","s3.amazonaws.com"]
READCUBE_UPLOAD_ROOTS=[]
